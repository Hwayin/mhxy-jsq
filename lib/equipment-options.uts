export function choices(names: string[]): EquipmentChoice[] { return names.map(value => ({ value, label: value, group: '' })) }
export function ranks(max: number): EquipmentChoice[] { return choices(Array.from({ length: max + 1 }, (_, i) => String(i))).map(c => ({ ...c, label: c.value + '锻' })) }
