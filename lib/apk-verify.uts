import { Sha256 } from './sha256.uts'
import type { ApkRelease } from './update-model.uts'

export async function verifyApk(fs: any, path: string, release: ApkRelease, cancelled: () => boolean, progress: (value: number) => void): Promise<void> {
  const fd = fs.openSync({ filePath: path, flag: 'r' })
  const hash = new Sha256()
  const buffer = new ArrayBuffer(131072)
  let total = 0
  try {
    while (true) {
      if (cancelled()) throw new Error('已取消更新')
      const result = fs.readSync({ fd, arrayBuffer: buffer, offset: 0, length: buffer.byteLength })
      if (result.bytesRead === 0) break
      const bytes = new Uint8Array(result.arrayBuffer,0,result.bytesRead)
      if (total === 0 && (bytes.length < 4 || bytes[0] !== 80 || bytes[1] !== 75 || bytes[2] !== 3 || bytes[3] !== 4)) throw new Error('下载内容不是 APK 安装包')
      total += bytes.length
      if (total > release.size) throw new Error('安装包大小不匹配，请重新下载')
      hash.update(bytes)
      progress(Math.floor(total/release.size*100))
      await new Promise<void>(resolve => { setTimeout(resolve,0) })
    }
    if (cancelled()) throw new Error('已取消更新')
    if (total !== release.size || hash.digest() !== release.sha256) throw new Error('安装包校验失败，请重新下载')
  } finally { fs.closeSync({ fd }) }
}
