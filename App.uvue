.tag { color: #287565; background-color: #e7f0ea; padding: 6rpx 14rpx; border-radius: 10rpx; font-size: 22rpx; }
.link { color: #287565; font-size: 26rpx; padding: 20rpx 0; }
.danger { color: #b85252; font-size: 26rpx; padding: 20rpx 0; }
.primary { color: #fffefb; background-color: #287565; border-radius: 20rpx; font-size: 28rpx; margin-top: 24rpx; min-height: 88rpx; }
.secondary { color: #287565; background-color: #e7f0ea; border-radius: 20rpx; font-size: 28rpx; margin-top: 20rpx; min-height: 88rpx; }
.outline { color: #287565; background-color: #fffefb; border-radius: 16rpx; border-width: 1rpx; border-color: #c7d9cb; font-size: 24rpx; padding: 16rpx 24rpx; }
.page-with-dock { padding-bottom: 260rpx; }
.action-dock { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 32rpx 28rpx; background-color: #f5f4ee; border-top-width: 1rpx; border-top-color: #e2e7dd; }
.dock-button { margin-top: 0; width: 100%; }
.seal { width: 88rpx; height: 88rpx; border-radius: 24rpx; background-color: #e7f0ea; align-items: center; justify-content: center; margin-right: 22rpx; }
.seal-text { font-size: 40rpx; color: #287565; font-weight: bold; }
.eyebrow { font-size: 22rpx; color: #887848; letter-spacing: 2rpx; margin-bottom: 12rpx; }
.chip-row { flex-direction: row; flex-wrap: wrap; margin-top: 16rpx; }
.chip { font-size: 24rpx; color: #6d7e74; background-color: #fffefb; padding: 18rpx 24rpx; border-radius: 24rpx; margin-right: 12rpx; margin-top: 8rpx; }
.chip-active { color: #fffefb; background-color: #287565; }
.label { color: #203a33; font-size: 26rpx; margin-bottom: 12rpx; }
.field { background-color: #f0f1e9; border-radius: 14rpx; padding: 20rpx; font-size: 28rpx; color: #203a33; height: 84rpx; }
