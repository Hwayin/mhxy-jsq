.card { background-color: #fffefb; border-radius: 28rpx; padding: 28rpx; margin-top: 20rpx; border-width: 1rpx; border-color: #e8ebe2; }
.hero { position: relative; overflow: hidden; background-color: #287565; border-radius: 28rpx; padding: 32rpx; margin-top: 24rpx; }
.hero-cloud { position: absolute; width: 240rpx; height: 160rpx; right: 0; top: 8rpx; }
.hero-label { color: #d8e8df; font-size: 26rpx; }
.hero-money { color: #fffefb; font-size: 62rpx; font-weight: bold; margin-top: 16rpx; }
.hero-note { color: #d8e8df; font-size: 24rpx; margin-top: 18rpx; line-height: 38rpx; }
