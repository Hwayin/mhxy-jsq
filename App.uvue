<script setup>
import { scheduleStartupUpdateCheck } from './lib/app-update.uts'
onLaunch(() => { console.log('梦幻多开账本已启动'); scheduleStartupUpdateCheck() })

// #ifdef APP-ANDROID
let exitDialogOpen = false
// 最后一页的系统返回由应用统一处理，详情页仍正常返回上一页。
onLastPageBackPress(() => {
  if (exitDialogOpen) return
  exitDialogOpen = true
  uni.showModal({
    title: '退出应用',
    content: '确定退出梦幻多开账本吗？已保存的账本会保留在本机。',
    cancelText: '继续使用',
    confirmText: '退出',
    confirmColor: '#287565',
    success: res => { if (res.confirm) uni.exit() },
    complete: () => { exitDialogOpen = false }
  })
})
onExit(() => { exitDialogOpen = false })
// #endif
</script>

<style>
/* App 页面仅使用简单类选择器，文字显式设色；适配原生渲染。 */
