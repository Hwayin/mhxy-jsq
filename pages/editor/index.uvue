})
function choiceValues(key: string): string[] { if (key === 'roleRace') return form.race ? [form.race] : []; if (key.startsWith('green:')) { const row = greenRows.value.find(r => r.id === key.slice(6)); return row?.kind ? [row.kind] : [] }; if (key === 'itemId') return [attrs.itemId || '__generic__']; const value = attrs[key]; return Array.isArray(value) ? value.slice() : value ? [String(value)] : [] }
function choiceValue(field: EquipmentField): string { return choiceValues(field.key).map(v => field.options.find(o => o.value === v)?.label || v).join(' / ') }
function openChoice(field: EquipmentField) { activeChoice.value = field }
function applyChoice(values: string[]) {
  if (!activeChoice.value) return
  if (activeChoice.value.key === 'roleRace') { form.race = values[0] || ''; activeChoice.value = null; return }
  if (activeChoice.value.key.startsWith('green:')) { const row = greenRows.value.find(r => r.id === activeChoice.value?.key.slice(6)); if (row) row.kind = values[0] || ''; activeChoice.value = null; return }
  if (activeChoice.value.key === 'itemId') {
    const item = EQUIPMENT_ITEMS.find(i => i.id === values[0])
    if (!item && values[0] === attrs.itemId) { activeChoice.value = null; return }
    attrs.itemId = item?.id || ''; attrs.itemName = item?.name || ''
    if (item) { if (item.subtype === 'jade') attrs.jadeKind = item.slot; else attrs.slot = item.slot; if (!attrs.level && item.levels.length === 1) attrs.level = String(item.levels[0]) }
    activeChoice.value = null; return
  }
  // 明确选择或清空专用锻数时，替换旧版共用宝石字段，避免清空后又回退到旧值。
  if (activeChoice.value.key === 'starRank' || activeChoice.value.key === 'dustRank') { attrs.gemRank = ''; attrs.gem = '' }
  attrs[activeChoice.value.key] = activeChoice.value.multiple ? values.slice() : values[0] || ''
  activeChoice.value = null
}
function snapshot() { return JSON.stringify({ form, attrs, baseValues, rules, greenRows: greenRows.value, extraGemEnabled: extraGemEnabled.value, expanded: expanded.value, step: step.value }) }
function leaveEditor() { leaving = true; uni.navigateBack() }
onBackPress(() => {
  if (leaving) return false
  if (activeChoice.value) { activeChoice.value = null; return true }
  if (equipmentWizard.value && step.value > 0) { previousStep(); return true }
  if (!initialSnapshot || snapshot() === initialSnapshot || fatal.value) return false
  if (leaveDialogOpen) return true
  leaveDialogOpen = true
  uni.showActionSheet({ itemList: ['保留草稿并返回', '放弃修改并返回', '继续编辑'], success: res => {
    try {
      if (res.tapIndex === 0) { uni.setStorageSync(draftKey.value, snapshot()); leaveEditor() }
      if (res.tapIndex === 1) { uni.removeStorageSync(draftKey.value); leaveEditor() }
    } catch(e) { error.value = '草稿操作失败：' + errorMessage(e) }
  }, complete: () => { leaveDialogOpen = false } })
  return true
})
function restoreDraft() {
  const raw = uni.getStorageSync(draftKey.value)
  if (typeof raw !== 'string' || !raw) return
  uni.showModal({ title: '发现未保存的草稿', content: '恢复上次保留的内容继续编辑？', confirmText: '恢复草稿', cancelText: '重新录入', success: res => {
    if (!res.confirm) { uni.removeStorageSync(draftKey.value); return }
    try {
      const draft = JSON.parse(raw)
      if (!draft || !draft.form || !draft.attrs || !draft.baseValues || !draft.rules || !Array.isArray(draft.greenRows)) throw new Error('草稿内容不完整')
      Object.assign(form, draft.form); Object.assign(attrs, draft.attrs); Object.assign(baseValues, draft.baseValues); Object.assign(rules, draft.rules)
      greenRows.value = draft.greenRows; extraGemEnabled.value = !!draft.extraGemEnabled; expanded.value = !!draft.expanded
      step.value = [0,1,2].includes(draft.step) ? draft.step : 0
    } catch(e) { error.value = '草稿恢复失败：' + errorMessage(e) }
  } })
}
function previousStep() { step.value = Math.max(0, step.value - 1); error.value = ''; uni.pageScrollTo({ scrollTop: 0, duration: 0 }) }
function submitStep() {
  if (!equipmentWizard.value || step.value === 2) { save(); return }
  error.value = ''
  try {
    if (step.value === 0) {
      toCents(form.amount)
      if (!EQUIPMENT_POSITIONS.find(type => type.key === form.subtype)?.positions.includes(form.subtype === 'jade' ? attrs.jadeKind : attrs.slot)) throw new Error('请选择具体装备类型和部位')
      if (form.subtype !== 'jade' && (!/^\d{1,3}$/.test(attrs.level) || Number(attrs.level) > 160)) throw new Error('请选择有效的资产等级')
      if (form.date && !/^\d{4}-\d{2}-\d{2}$/.test(form.date)) throw new Error('日期格式应为 YYYY-MM-DD')
    } else { buildAttributes() }
    step.value++; uni.pageScrollTo({ scrollTop: 0, duration: 0 })
  } catch(e) { error.value = errorMessage(e) }
}
const equipmentSetBlocked = computed(() => legacyEquipmentSet.value || form.purchaseKind === 'set')
const title = computed(() => equipmentWizard.value ? (recordId.value ? '编辑装备' : '记录装备') : (recordId.value ? '编辑' : '新增') + (kind.value === 'accounts' ? '账号' : kind.value === 'roles' ? '角色' : '明细'))
watch(title, value => uni.setNavigationBarTitle({ title: value }), { immediate: true })
const categoryLabel = computed(() => CATEGORIES.find(c => c.key === form.category)?.label || '资产')
const canInclude = computed(() => bundled.value && form.category !== 'other')
const subtypeName = computed(() => SUBTYPES.find(s => s.key === form.subtype && s.category === form.category)?.label || '未细分')
const suggestion = computed(() => suggestSubtype(form.category, form.name))
const suggestionName = computed(() => SUBTYPES.find(s => s.key === suggestion.value)?.label || '')
const detailPlaceholder = computed(() => form.category === 'pet' ? '例如：画魂 · 4技能 · 须弥 · 成长1.27' : form.category === 'equipment' ? '例如：初灵182、魔力27、法伤属性。上方已选择的内容无需重复填写。' : '例如：点修、技能、手续费、月卡或硬件分摊')
onLoad(options => {
  try {
    kind.value = options.kind || 'accounts'
    if (!['accounts', 'roles', 'assets'].includes(kind.value)) throw new Error('页面参数不正确')
    recordId.value = options.id || ''
    parent.value = options.parent || ''
    const data = loadLedger()
    if (CATEGORIES.some(c => c.key === options.category)) form.category = String(options.category)
    if (SUBTYPES.some(s => s.key === options.subtype && s.category === form.category)) form.subtype = String(options.subtype)
    if (recordId.value) {
      const records = data[kind.value as keyof Ledger] as (Account | Role | Asset)[]
      const existing = records.find(r => r.id === recordId.value)
      if (!existing) throw new Error('记录不存在或已删除')
      Object.assign(form, existing)
      if (kind.value === 'roles') { const role = existing as Role; form.race = role.race || ''; if (role.calculation) { rules.fixedEnabled = role.calculation.fixedEnabled || false; for(const key of ['fixedDamageRate','fixedAgilityRate','magicDamageRate','powerRate','enduranceRate']) rules[key] = role.calculation[key] != null ? String(role.calculation[key]) : '' }; form.level = String(role.level); form.amount = amountInput(role.purchaseCents); parent.value = role.accountId }
      if (kind.value === 'assets') {
        const asset = existing as Asset; form.amount = amountInput(asset.costCents); parent.value = asset.roleId
        form.originalName = asset.originalName || (!asset.nameGenerated ? asset.name : '');
        form.subtype = assetSubtype(asset); form.purchaseKind = asset.purchaseKind || 'single'; form.contents = asset.contents || ''
        legacyEquipmentSet.value = isEquipmentSet(asset)
        form.quantity = asset.quantity != null ? String(asset.quantity) : ''
        if (asset.attributes) {
          const a = asset.attributes
          attrs.extraGem = a.extraGem || ''; attrs.extraGemRank = a.extraGemRank != null ? String(a.extraGemRank) : ''; extraGemEnabled.value = !!a.extraGem; attrs.valuesStage = a.valuesStage || 'finished'
          for(const row of a.baseAttributes || []) baseValues[row.kind] = String(row.value)
          attrs.baseKind = a.baseAttributes?.[0]?.kind || ''
          attrs.itemId = a.itemId || ''; attrs.itemName = a.itemName || ''
          greenRows.value = (a.greenAttributes || []).map(r => ({ id: makeId(), kind: r.kind, value: String(Math.abs(r.value)), negative: r.value < 0, unit: r.unit || '', perRank: r.perRank != null ? String(r.perRank) : '' }))
          attrs.slot = form.subtype === 'jade' ? a.slot || '' : equipmentPosition(asset); attrs.gem = a.gem || ''; attrs.effect = a.effect || ''; attrs.petType = a.petType || ''; attrs.skills = a.skills || ''; attrs.growth = a.growth || ''
          attrs.level = a.level != null ? String(a.level) : ''; attrs.gemRank = a.gemRank != null ? String(a.gemRank) : ''; expanded.value = !!(a.effect || a.petType || a.skills || a.growth)
          attrs.setEffect = a.setEffect || ''; attrs.specialSkill = a.specialSkill || ''; attrs.specialEffects = a.specialEffects?.slice() || []
          attrs.bellSet = a.bellSet || ''; attrs.jadeKind = a.jadeKind || ''; attrs.jadeEffects = a.jadeEffects?.slice() || []; attrs.ambushSkills = a.ambushSkills?.slice() || []
          attrs.starRank = a.starRank != null ? String(a.starRank) : form.subtype === 'ornament' && a.gemRank != null ? String(a.gemRank) : ''
          attrs.bellLevel = a.bellLevel != null ? String(a.bellLevel) : ''
          attrs.dustRank = a.dustRank != null ? String(a.dustRank) : form.subtype === 'jade' && a.gemRank != null && a.gemRank <= 15 ? String(a.gemRank) : ''
        }
      }
    }
    if (kind.value === 'assets' && !recordId.value && form.category === 'equipment' && !form.subtype) form.subtype = 'gear'
    if (kind.value === 'roles') {
      const account = data.accounts.find(a => a.id === parent.value)
      if (!account) throw new Error('请先创建账号，再添加角色')
      parentName.value = account.name
    }
    if (kind.value === 'assets') {
      const role = data.roles.find(r => r.id === parent.value)
      if (!role) throw new Error('请先创建角色，再添加明细')
      parentRole.value = role; parentName.value = role.name; roleSchool.value = role.school; bundled.value = role.purchaseMode === 'bundle'
    }
    nextTick(() => { initialSnapshot = snapshot(); restoreDraft() })
  } catch (e) { fatal.value = errorMessage(e) }
})
function chooseSchool() {
  // 每组最多 5 项，兼容原生 actionSheet 的菜单项数限制。
  uni.showActionSheet({ itemList: ['大唐官府～天宫', '龙宫～魔王寨', '狮驼岭～无底洞', '花果山～其他'], success: first => {
    const list = SCHOOLS.slice(first.tapIndex * 5, first.tapIndex * 5 + 5)
    uni.showActionSheet({ itemList: list, success: second => { form.school = list[second.tapIndex] } })
  } })
}
function chooseCategory() { uni.showActionSheet({ itemList: CATEGORIES.map(c => c.label), success: res => { form.category = CATEGORIES[res.tapIndex].key; form.subtype = form.category === 'equipment' ? 'gear' : ''; if (!canInclude.value) form.included = false } }) }
function chooseSubtype() {
  const list = SUBTYPES.filter(s => s.category === form.category)
  uni.showActionSheet({ itemList: ['暂不细分', ...list.map(s => s.label)], success: res => { form.subtype = res.tapIndex === 0 ? '' : list[res.tapIndex - 1].key } })
}
function optionalInt(raw: string, label: string): number | undefined {
  if (!raw.trim()) return undefined
  if (!/^\d{1,3}$/.test(raw.trim())) throw new Error(label + '应为整数')
  return Number(raw)
}
function buildAttributes(): AssetAttributes | undefined {
  const result: AssetAttributes = {}
  if (form.category === 'equipment') {
    const base = baseRows(true); if (base.length) result.baseAttributes = base
    result.valuesStage = attrs.valuesStage
    if (attrs.extraGem) result.extraGem = attrs.extraGem
    if (attrs.extraGemRank !== '') result.extraGemRank = optionalInt(attrs.extraGemRank,'第二宝石锻数')
    const green = numericRows(true); if (green.length) result.greenAttributes = green
    // 保留其他类型的已录属性，切换类型后可切回；清空当前选项会确实移除该字段。
    for (const key of ['itemId', 'itemName', 'slot', 'gem', 'setEffect', 'specialSkill', 'bellSet', 'jadeKind']) if (attrs[key].trim()) result[key] = attrs[key].trim()
    for (const [key, label] of [['level', '资产等级'], ['gemRank', '宝石锻数'], ['starRank', '星辉石锻数'], ['bellLevel', '钟灵石等级'], ['dustRank', '五色灵尘锻数']]) {
      const value = optionalInt(attrs[key], label); if (value !== undefined) result[key] = value
    }
    for (const key of ['specialEffects', 'jadeEffects', 'ambushSkills']) if (attrs[key].length) result[key] = attrs[key].slice()
  }
  if (form.category === 'pet') {
    if (attrs.petType.trim()) result.petType = attrs.petType.trim()
    if (attrs.skills.trim()) result.skills = attrs.skills.trim()
    if (attrs.growth.trim()) result.growth = attrs.growth.trim()
  }
  if (form.category !== 'other' && attrs.effect.trim()) result.effect = attrs.effect.trim()
  return Object.keys(result).length ? result : undefined
}
function save() {
  if (saving.value || fatal.value) return
  saving.value = true; error.value = ''
  try {
    const data = loadLedger()
    const id = recordId.value || makeId()
    let record: Account | Role | Asset | null = null
    if (kind.value === 'accounts') record = { id, name: form.name.trim(), group: form.group.trim(), note: form.note.trim() }
    if (kind.value === 'roles') {
      if (!/^\d{1,3}$/.test(String(form.level))) throw new Error('等级应为 0～200 的整数')
      if (form.purchaseMode !== 'bundle' && data.assets.some(a => a.roleId === id && a.included)) throw new Error('请先将随号资产改为独立计价，再切换起号方式，避免成本口径意外变化')
      record = { id, accountId: parent.value, name: form.name.trim(), server: form.server.trim(), school: form.school, level: Number(form.level), gameId: form.gameId.trim(), purchaseCents: toCents(form.amount), purchaseMode: form.purchaseMode, note: form.note.trim(), calculation: buildRules(), ...(form.race ? {race:form.race} : {}) }
    }
    if (kind.value === 'assets') {
      if (form.category === 'equipment' && equipmentSetBlocked.value) throw new Error('旧组合记录请逐件重新录入，不能直接转换为一件装备')
      if (form.category === 'equipment') { form.purchaseKind = 'single'; form.contents = ''; form.quantity = '' }
      const attributes = buildAttributes()
      record = { id, roleId: parent.value, name: form.category === 'equipment' ? generatedName.value : form.name.trim(),
        ...(form.category === 'equipment' ? { nameGenerated: true, ...(form.originalName ? { originalName: form.originalName } : {}) } : {}), category: form.category, costCents: toCents(form.amount), included: canInclude.value && form.included, date: form.date.trim(), detail: form.detail.trim(), note: form.note.trim(), purchaseKind: form.purchaseKind,
        ...(form.subtype ? { subtype: form.subtype } : {}),
        ...(form.purchaseKind === 'set' ? { contents: form.contents.trim() } : {}),
        ...(form.purchaseKind === 'set' && form.quantity.trim() ? { quantity: optionalInt(form.quantity, '组合数量') } : {}),
        ...(attributes ? { attributes } : {}) }
    }
    if (!record) throw new Error('记录类型不正确')
    saveLedger(putRecord(data, kind.value, record))
    try { uni.removeStorageSync(draftKey.value) } catch(e) { console.log('已保存记录，草稿清理失败', e) }
    recordId.value = id
    leaving = true
    uni.showToast({ title: '已保存', icon: 'success' })
    uni.navigateBack()
  } catch (e) { error.value = errorMessage(e); if (equipmentWizard.value) { step.value = /属性|宝石|锻|技能|数值|奇袭/.test(error.value) ? 1 : 0 } }
  finally { saving.value = false }
}
</script>
