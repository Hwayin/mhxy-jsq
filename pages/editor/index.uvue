<template>
  <view class="page page-with-dock">
    <text v-if="!equipmentWizard" class="title">{{ title }}</text>
    <text v-if="!equipmentWizard" class="subtitle">{{ kind === 'assets' ? '记录实际购入成本，保留每一笔投入的细节。' : '建立清晰的账号与角色档案。' }}</text>
    <view v-if="equipmentWizard && !fatal" class="stepper"><view v-for="(name,index) in stepNames" :key="name" :class="['step-item', step === index ? 'step-active' : '']"><text class="step-number">{{ index + 1 }}</text><text class="step-label">{{ name }}</text></view></view>
    <text v-if="fatal" class="error">{{ fatal }}</text>
    <view v-else class="card">
      <view v-if="kind !== 'assets' || form.category !== 'equipment'" class="field-group"><text class="label">{{ kind === 'accounts' ? '账号别名' : kind === 'roles' ? '角色名称' : '明细名称' }} *</text><input class="field" :value="form.name" @input="form.name = $event.detail.value" @blur="form.name = $event.detail.value" maxlength="200" placeholder="请输入名称" /></view>
      <view v-else class="row selected-item"><ItemIcon :item-id="attrs.itemId" :item-name="attrs.itemName" :label="attrs.slot || attrs.jadeKind || '装备'" /><view class="grow selected-item-copy"><text class="label">{{ attrs.itemName || '选择具体物品' }}</text><text class="muted">{{ parentName }} · {{ subtypeName }}{{ attrs.level ? ' · ' + attrs.level + '级' : '' }}</text></view></view>
      <template v-if="kind === 'accounts'">
        <view class="field-group"><text class="label">所属队伍</text><input class="field" :value="form.group" @input="form.group = $event.detail.value" @blur="form.group = $event.detail.value" maxlength="200" placeholder="例如：109五开队 / 129主力队" /></view>
      </template>
      <template v-if="kind === 'roles'">
        <text class="muted">所属账号：{{ parentName }}</text>
        <view class="field-group"><text class="label">服务器 *</text><input class="field" :value="form.server" @input="form.server = $event.detail.value" @blur="form.server = $event.detail.value" maxlength="200" placeholder="例如：浙江一区 · 西栅老街" /></view>
        <view class="field-group"><text class="label">门派 *</text><view class="field between" @click="chooseSchool"><text class="body">{{ form.school }}</text><text class="link">选择 ›</text></view></view>
        <view class="field-group"><text class="label">角色种族（装备换算）</text><view class="field between" @click="openChoice(choiceField('roleRace','角色种族',RACES.map(r => ({value:r.key,label:r.label,group:''})),false,false))"><text class="body">{{ raceName }}</text><text class="link">选择 ›</text></view></view>
        <view class="field-group"><view class="between"><text class="label">启用固伤基础换算</text><switch :checked="rules.fixedEnabled" @change="rules.fixedEnabled = $event.detail.value" color="#287565" /></view><text class="muted">{{ fixedPreset?.condition || '当前门派无预设，启用后需填写自定义系数。' }}</text><text class="muted">只比较装备贡献，需确认对应经脉已生效。</text></view>
        <view v-for="rate in roleRateFields" :key="rate.key" class="field-group"><text class="label">{{ rate.label }}（可校准）</text><input class="field" :value="rules[rate.key]" @input="rules[rate.key] = $event.detail.value" @blur="rules[rate.key] = $event.detail.value" type="digit" :placeholder="rate.hint" /></view>
        <view class="field-group"><text class="label">等级</text><input class="field" :value="form.level" @input="form.level = $event.detail.value" @blur="form.level = $event.detail.value" type="number" placeholder="例如：109" /></view>
        <view class="field-group"><text class="label">游戏角色 ID（可选）</text><input class="field" :value="form.gameId" @input="form.gameId = $event.detail.value" @blur="form.gameId = $event.detail.value" maxlength="200" placeholder="便于核对角色" /></view>
        <view class="field-group"><text class="label">起号方式</text><view class="mode-options"><view v-for="mode in modes" :key="mode.key" :class="['mode-option', form.purchaseMode === mode.key ? 'mode-active' : '']" @click="form.purchaseMode = mode.key"><text :class="['mode-text', form.purchaseMode === mode.key ? 'mode-text-active' : '']">{{ mode.label }}</text></view></view><text class="muted">{{ purchaseHint(form.purchaseMode) }}</text></view>
        <view v-if="form.purchaseMode !== 'self' && form.note.includes('从0起号')" class="notice"><text class="notice-text">备注提到了“从0起号”，你可以将起号方式改为“自建起号”。</text></view>
        <view class="field-group"><text class="label">{{ form.purchaseMode === 'self' ? '起号基础投入（人民币元）' : '购号价格（人民币元）' }} *</text><input class="field" :value="form.amount" @input="form.amount = $event.detail.value" @blur="form.amount = $event.detail.value" type="digit" placeholder="0.00" /></view>
      </template>
      <template v-if="kind === 'assets'">
        <text v-if="!equipmentWizard" class="muted">所属角色：{{ parentName }}</text><text v-if="equipmentWizard && step === 0" class="link category-context" @click="chooseCategory">{{ categoryLabel }} · 切换分类 ›</text>
        <view v-if="!equipmentWizard" class="field-group"><text class="label">分类</text><view class="field between" @click="chooseCategory"><text class="body">{{ categoryLabel }}</text><text class="link">选择 ›</text></view></view>
        <view v-if="form.category === 'equipment'" v-show="!equipmentWizard || step !== 2" class="equipment-section"><text v-show="!equipmentWizard || step === 0" class="label">装备类型</text><view v-show="!equipmentWizard || step === 0" class="mode-options"><view v-for="option in equipmentTypes" :key="option.key" :class="['mode-option', form.subtype === option.key ? 'mode-active' : '']" @click="form.subtype = option.key"><text :class="['mode-text', form.subtype === option.key ? 'mode-text-active' : '']">{{ option.label }}</text></view></view><text v-if="!form.subtype" class="muted">请选择具体装备类型和部位，再保存单件记录。</text><view :class="['equipment-fields', equipmentWizard && step === 0 ? 'identity-fields' : '']"><view v-for="field in visibleEquipmentFields" :key="field.key" :class="['field-group', 'equipment-choice', equipmentWizard && step === 0 ? 'identity-field' : '', field.key === 'itemId' ? 'identity-wide' : '']"><text class="label">{{ field.label }}</text><view class="field between" @click="openChoice(field)"><text :class="['choice-value', choiceValue(field) ? 'body' : 'muted']">{{ choiceValue(field) || '未配置' }}</text><text class="link">选择 ›</text></view></view></view><view v-show="!equipmentWizard || step === 1"><text v-if="form.subtype === 'gear'" class="link" @click="toggleExtraGem">{{ extraGemEnabled ? '移除第二种宝石' : '＋ 记录混合镶嵌' }}</text><text v-if="form.subtype === 'gear' && extraGemEnabled" class="muted">混镶填每种宝石各自占用的段数，两项之和为总锻数。</text><view class="base-section"><text class="label">基础属性（未含宝石）</text><text class="muted">装备填未镶宝石的白字（含已有熔炼）；灵饰、玉魄分别记录基础词条与附加词条。</text><view v-if="form.subtype !== 'gear'" class="field-group"><text class="label">基础属性类型</text><view class="field between" @click="baseChoices"><text class="body">{{ attrs.baseKind || '选择属性' }}</text><text class="link">选择 ›</text></view></view><view v-for="kindName in baseKinds" :key="kindName" class="field-group base-value"><text class="label">{{ kindName === '伤害' && form.subtype === 'gear' ? '初始伤害（不含命中换算）' : '初始' + kindName }}</text><input class="field" :value="baseValues[kindName]" @input="baseValues[kindName] = $event.detail.value" @blur="baseValues[kindName] = $event.detail.value" type="digit" placeholder="未录入留空；0表示已确认无加成" /></view></view><view v-if="form.subtype !== 'gear'" class="field-group"><text class="label">附加属性录入口径</text><view class="mode-options"><view :class="['mode-option',attrs.valuesStage === 'finished' ? 'mode-active' : '']" @click="attrs.valuesStage = 'finished'"><text class="body">当前成品值</text></view><view :class="['mode-option',attrs.valuesStage === 'initial' ? 'mode-active' : '']" @click="attrs.valuesStage = 'initial'"><text class="body">初始值＋强化</text></view></view><text class="muted">成品值不会再次叠加强化；玉魄填当前人物实际生效值。初始模式逐条填写每级增量，未填写时显示待计算。</text></view><view class="numeric-section"><view class="between"><text class="label">{{ form.subtype === 'gear' ? '绿字属性' : form.subtype === 'ornament' ? '灵饰附加属性' : '玉魄数值属性' }}</text><text class="muted">{{ greenRows.length }}项</text></view><text class="muted">先选择属性，再填写数值。点击＋可切换为负值。</text><view v-for="row in greenRows" :key="row.id" class="numeric-row"><view class="between"><view class="field numeric-kind" @click="chooseGreen(row.id)"><text class="body">{{ row.kind || '选择属性 ›' }}</text></view><text class="danger numeric-remove" @click="removeGreen(row.id)">删除</text></view><view class="numeric-input-row"><text class="numeric-sign" @click="row.negative = !row.negative">{{ row.negative ? '−' : '＋' }}</text><input class="field numeric-value" :value="row.value" @input="row.value = $event.detail.value" @blur="row.value = $event.detail.value" type="digit" maxlength="12" placeholder="输入数值，可填0" /><text v-if="form.subtype !== 'gear' || row.unit" class="numeric-unit" @click="row.unit = form.subtype === 'gear' ? '' : row.unit === '%' ? '' : '%'">{{ row.unit || '点' }} ↕</text><text v-else class="muted">点</text></view><view v-if="form.subtype !== 'gear' && attrs.valuesStage === 'initial'" class="field-group"><text class="label">每级强化增量（同属性单位）</text><input class="field" :value="row.perRank" @input="row.perRank = $event.detail.value" @blur="row.perRank = $event.detail.value" type="digit" placeholder="按游戏词条填写，0表示此项无强化" /></view></view><text v-if="greenRows.length < (form.subtype === 'gear' ? 5 : 12)" class="link" @click="addGreen">＋ 添加属性</text></view></view></view><view v-if="form.category !== 'equipment'" class="field-group"><text class="label">细分类型</text><view class="field between" @click="chooseSubtype"><text class="body">{{ subtypeName }}</text><text class="link">选择 ›</text></view><text v-if="suggestion && suggestion !== form.subtype" class="link" @click="form.subtype = suggestion">按名称建议：{{ suggestionName }} · 点击采用</text></view>
        <text v-if="form.category === 'equipment' && suggestion && suggestion !== form.subtype" class="link" @click="form.subtype = suggestion">按名称建议：{{ suggestionName }} · 点击采用</text><view v-if="form.category !== 'equipment'" class="field-group"><view class="between"><text class="body">组合购入</text><switch :checked="form.purchaseKind === 'set'" color="#287565" @change="form.purchaseKind = $event.detail.value ? 'set' : 'single'" /></view><text class="muted">多件一起购买时，填写整单总价，包含内容只作说明。</text></view>
        <view v-if="form.category !== 'equipment' && form.purchaseKind === 'set'" class="field-group"><text class="label">包含内容</text><textarea class="textarea" :value="form.contents" @input="form.contents = $event.detail.value" @blur="form.contents = $event.detail.value" maxlength="2000" placeholder="例如：召唤兽＋高连套。每行一项，不重复填写费用。" /><text class="label quantity-label">件数（可选）</text><input class="field" :value="form.quantity" @input="form.quantity = $event.detail.value" @blur="form.quantity = $event.detail.value" type="number" placeholder="数量不明确可留空" /></view>
        <view v-if="form.category === 'equipment' && equipmentSetBlocked" class="notice"><text class="notice-text">{{ equipmentSetBlocked ? '这是旧组合记录，请逐件重新录入并核对原总价后删除旧记录。' : '装备、灵饰、上古玉魄按单件记录。每件选择具体部位，分别填写实际成本。' }}</text><text v-if="equipmentSetBlocked" class="muted">原组合：{{ form.name }} · {{ form.quantity || '未注明' }}件 · 总价 {{ form.amount }}元。{{ form.contents }}</text></view><view v-show="!equipmentWizard || step === 0" class="field-group amount-group"><text class="label">{{ form.included ? '明细参考价（人民币元，不重复计入）' : form.category !== 'equipment' && form.purchaseKind === 'set' ? '组合总价（人民币元）' : '实际投入（人民币元）' }} *</text><input class="field" :value="form.amount" @input="form.amount = $event.detail.value" @blur="form.amount = $event.detail.value" type="digit" placeholder="0.00" /></view>
        <view v-if="canInclude" v-show="!equipmentWizard || step === 0" class="field-group"><view class="between"><text class="body">购号价已包含此资产</text><switch :checked="form.included" color="#287565" @change="form.included = $event.detail.value" /></view><text class="muted">开启后，此金额仅用于明细展示，不再叠加到总成本。</text></view>
        <view v-if="form.category === 'equipment' && calculationPreview.metrics.length" v-show="!equipmentWizard || step === 1" class="calculation-panel"><text class="label">自动换算 · 当前角色 {{ parentName }}</text><text class="muted">基础 / 增量 / 强化后；估算项见公式。空值不按0计算。</text><view v-for="metric in calculationPreview.metrics" :key="metric.key" class="metric-row"><text class="metric-label">{{ metric.label }}</text><text class="metric-value">{{ valueText(metric.value,metric.unit) }}</text><text v-if="metric.initial != null || metric.bonus != null" class="muted">{{ valueText(metric.initial,metric.unit) }} ＋ {{ valueText(metric.bonus,metric.unit) }} → {{ valueText(metric.value,metric.unit) }}</text><text class="metric-formula">{{ metric.formula }}</text></view><text v-for="(note,index) in calculationPreview.notes" :key="index" class="notice-text">{{ note }}</text></view>
        <view v-show="!equipmentWizard || step === 0" class="field-group"><text class="label">购入日期（可选）</text><input class="field" :value="form.date" @input="form.date = $event.detail.value" @blur="form.date = $event.detail.value" maxlength="10" placeholder="YYYY-MM-DD，例如 2026-10-08" /></view>
        <view v-show="!equipmentWizard || step === 1" class="field-group"><text class="label">{{ form.category === 'pet' ? '召唤兽属性' : form.category === 'equipment' ? '补充数值 / 属性说明（可选）' : '投入说明' }}</text><textarea class="textarea" :value="form.detail" @input="form.detail = $event.detail.value" @blur="form.detail = $event.detail.value" maxlength="2000" :placeholder="detailPlaceholder" /></view>
        <view v-if="form.category !== 'other'" v-show="!equipmentWizard || step === 1" class="field-group">
          <text class="link" @click="expanded = !expanded">{{ expanded ? '收起补充属性 ↑' : '补充属性（可选） ↓' }}</text>
          <view v-if="expanded">
            <template v-if="form.category === 'pet'">
              <view class="field-group"><text class="label">召唤兽类型</text><input class="field" :value="attrs.petType" @input="attrs.petType = $event.detail.value" @blur="attrs.petType = $event.detail.value" maxlength="100" placeholder="例如：全力 / 须弥 / 血宠" /></view>
              <view class="field-group"><text class="label">主要技能</text><input class="field" :value="attrs.skills" @input="attrs.skills = $event.detail.value" @blur="attrs.skills = $event.detail.value" maxlength="500" placeholder="填写你需要比较的技能" /></view>
              <view class="field-group"><text class="label">成长</text><input class="field" :value="attrs.growth" @input="attrs.growth = $event.detail.value" @blur="attrs.growth = $event.detail.value" type="digit" placeholder="例如：1.27" /></view>
            </template>
            <view class="field-group"><text class="label">关键属性 / 套装</text><input class="field" :value="attrs.effect" @input="attrs.effect = $event.detail.value" @blur="attrs.effect = $event.detail.value" maxlength="500" placeholder="例如：初灵182 / 魔力27 / 如意套 / 高连套" /></view>
          </view>
        </view>
      </template>
      <view v-show="!equipmentWizard || step === 0" class="field-group"><text class="label">备注（选填）</text><textarea class="textarea" :value="form.note" @input="form.note = $event.detail.value" @blur="form.note = $event.detail.value" maxlength="2000" placeholder="购买渠道、费用组成或其他补充信息" /></view>
      <view v-if="equipmentWizard && step === 2" class="review-panel"><text class="section-title">确认这笔记录</text><text class="generated-title review-name">{{ generatedName }}</text><view class="between"><text class="body">{{ form.included ? '随号资产参考价' : '新增投入' }}</text><text class="review-money">¥{{ form.amount }}</text></view><text class="muted">{{ form.included ? '购号价已包含，不重复计入累计投入。' : '保存后计入角色累计投入。' }}</text><view class="review-configuration"><text class="label">最终配置</text><text class="body">{{ reviewConfiguration }}</text></view><text v-if="form.date" class="muted">购入日期：{{ form.date }}</text><text v-if="form.note" class="body review-note">备注：{{ form.note }}</text><text v-if="form.detail" class="body review-note">说明：{{ form.detail }}</text></view>
      <text v-if="equipmentWizard && step === 0" class="muted step-hint">下一步填写属性与宝石配置。</text>
    </view>
    <text v-if="error" class="error editor-error">{{ error }}</text>
    <view v-if="!fatal" class="action-dock editor-dock" :style="{ paddingBottom: dockPadding }"><text v-if="equipmentWizard && step > 0" class="link previous-step" @click="previousStep">上一步</text><button class="primary dock-button editor-submit" :disabled="saving || (kind === 'assets' && form.category === 'equipment' && equipmentSetBlocked)" @click="submitStep">{{ saving ? '保存中…' : equipmentWizard && step < 2 ? '下一步：' + stepNames[step + 1] : '保存记录' }}</button></view>
    <AttributePicker v-if="activeChoice" :title="activeChoice?.label || ''" :options="activeChoice?.options || []" :values="choiceValues(activeChoice?.key || '')" :multiple="activeChoice?.multiple || false" :allowCustom="activeChoice?.allowCustom || false" :show-item-icons="activeChoice?.key === 'itemId'" @close="activeChoice = null" @confirm="applyChoice" />
  </view>
</template>
<script setup>
import { safeBottomPadding } from '../../lib/ui-layout.uts'
const dockPadding = ref(safeBottomPadding())
onResize(() => { dockPadding.value = safeBottomPadding() })
import { CATEGORIES, SUBTYPES, PURCHASE_MODES, purchaseHint, suggestSubtype, assetSubtype, EQUIPMENT_POSITIONS, equipmentPosition, isEquipmentSet, GREEN_ATTRIBUTE_OPTIONS, equipmentName, attributeText, SCHOOLS, makeId, amountInput, toCents, putRecord, errorMessage } from '../../lib/ledger.uts'
import type { Ledger, Account, Role, Asset, AssetAttributes, NumericAttribute } from '../../lib/ledger.uts'
import AttributePicker from '../../components/attribute-picker.uvue'
import ItemIcon from '../../components/item-icon.uvue'
import { choices, ranks, GEMS, SET_EFFECTS, SPECIAL_SKILLS, SPECIAL_EFFECTS, BELL_SETS, JADE_EFFECTS, AMBUSH_SKILLS } from '../../lib/equipment-options.uts'
import type { EquipmentChoice } from '../../lib/equipment-options.uts'
import { EQUIPMENT_ITEMS } from '../../lib/item-catalog.uts'
import { RACES, FIXED_PRESETS, BASE_FIELDS, equipmentCalculation, valueText } from '../../lib/equipment-calc.uts'
import type { CalculationRules } from '../../lib/ledger.uts'
import { loadLedger, saveLedger } from '../../lib/storage.uts'
const step = ref(0)
const stepNames = ['基本信息', '属性配置', '确认保存']
const equipmentWizard = computed(() => kind.value === 'assets' && form.category === 'equipment')
const visibleEquipmentFields = computed(() => equipmentFields.value.filter(field => !equipmentWizard.value || (step.value === 0 ? ['slot','level','jadeKind','itemId'].includes(field.key) : !['slot','level','jadeKind','itemId'].includes(field.key))))
let initialSnapshot = ''
let leaving = false
let leaveDialogOpen = false
const draftKey = computed(() => 'mhxy-editor-draft-v1:' + kind.value + ':' + (recordId.value || parent.value || 'new'))
const kind = ref('accounts')
const recordId = ref('')
const parent = ref('')
const parentName = ref('')
const parentRole = ref<Role | null>(null)
const extraGemEnabled = ref(false)
const baseValues = reactive({ 伤害:'', 命中:'', 灵力:'', 防御:'', 气血:'', 魔法:'', 敏捷:'', 速度:'', 法术防御:'', 法术伤害:'', 固定伤害:'', 封印命中等级:'', 抗封印等级:'', 抵抗封印等级:'', 狂暴等级:'', 物理暴击等级:'', 法术暴击等级:'', 固伤暴击等级:'', 抗物理暴击等级:'', 抗法术暴击等级:'', 抗固伤暴击等级:'', 格挡值:'', 法术伤害结果:'', 气血回复效果:'', 穿刺等级:'', 治疗能力:'' })
const rules = reactive({ fixedEnabled:false, fixedDamageRate:'', fixedAgilityRate:'', magicDamageRate:'', powerRate:'', enduranceRate:'' })
const bundled = ref(false)
const fatal = ref('')
const error = ref('')
const saving = ref(false)
const modes = PURCHASE_MODES
const expanded = ref(false)
const legacyEquipmentSet = ref(false)
type GreenDraft = { id: string; kind: string; value: string; negative: boolean; unit: string; perRank: string }
const greenRows = ref<GreenDraft[]>([])
const attrs = reactive({ extraGem: '', extraGemRank: '', valuesStage: 'finished', baseKind: '', itemId: '', itemName: '', slot: '', level: '', gem: '', gemRank: '', effect: '', petType: '', skills: '', growth: '', setEffect: '', specialSkill: '', specialEffects: [] as string[], starRank: '', bellSet: '', bellLevel: '', dustRank: '', jadeKind: '', jadeEffects: [] as string[], ambushSkills: [] as string[] })
const form = reactive({ name: '', group: '', server: '', school: SCHOOLS[0], level: '109', gameId: '', amount: '0.00', purchaseMode: 'self', category: 'equipment', included: false, date: '', detail: '', note: '', subtype: '', purchaseKind: 'single', contents: '', quantity: '', originalName: '', race: '' })
type EquipmentField = { key: string; label: string; options: EquipmentChoice[]; multiple: boolean; allowCustom: boolean }
const equipmentTypes = SUBTYPES.filter(s => s.category === 'equipment')
const roleSchool = ref('')
const activeChoice = ref<EquipmentField | null>(null)
function choiceField(key: string, label: string, options: EquipmentChoice[], multiple = false, allowCustom = true): EquipmentField { return { key, label, options, multiple, allowCustom } }
const itemOptions = computed(() => {
  const position = form.subtype === 'jade' ? attrs.jadeKind : attrs.slot
  const rows = EQUIPMENT_ITEMS.filter(i => i.subtype === form.subtype && (!position || i.slot === position) && (!attrs.level || form.subtype === 'jade' || i.levels.includes(Number(attrs.level))))
  return [{ value: '__generic__', label: '通用物品（按部位自动命名）', group: '通用' },
    ...(attrs.itemId && !EQUIPMENT_ITEMS.some(i => i.id === attrs.itemId) ? [{ value: attrs.itemId, label: attrs.itemName || '已有物品', group: '已保存' }] : []),
    ...rows.map(i => ({ value: i.id, label: i.name, group: i.kind + (i.levels.length ? ' · ' + i.levels.join('/') + '级' : '') }))]
