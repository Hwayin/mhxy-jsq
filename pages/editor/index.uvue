})
function addGreen() { greenRows.value.push({ id: makeId(), kind: '', value: '', negative: false, unit: '', perRank: '' }) }
function removeGreen(id: string) { greenRows.value = greenRows.value.filter(r => r.id !== id) }
function chooseGreen(id: string) {
