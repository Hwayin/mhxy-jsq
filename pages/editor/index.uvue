}
const equipmentFields = computed(() => {
  if (!form.subtype) return [] as EquipmentField[]
  const type = form.subtype
  const fields: EquipmentField[] = []
  if (type !== 'jade') {
    fields.push(choiceField('slot', '部位', choices(EQUIPMENT_POSITIONS.find(t => t.key === type)?.positions || []), false, false))
    fields.push(choiceField('level', '资产等级', choices((type === 'gear' ? Array.from({ length: 17 }, (_, i) => i * 10) : [60,80,100,120,140,160]).map(n => String(n))).map(o => ({ ...o, label: o.value + '级' })), false, false))
  }
  if (type !== 'jade') fields.push(choiceField('itemId', '物品名称', itemOptions.value, false, false))
  if (type === 'gear') {
    fields.push(choiceField('gem', '宝石类型', GEMS), choiceField('gemRank', '宝石锻数', ranks(30), false, false))
    if (extraGemEnabled.value) fields.push(choiceField('extraGem','第二宝石类型',GEMS),choiceField('extraGemRank','第二宝石锻数',ranks(30),false,false))
    fields.push(choiceField('setEffect', '套装效果', SET_EFFECTS), choiceField('specialSkill', '特技', SPECIAL_SKILLS), choiceField('specialEffects', '特效（可多选）', SPECIAL_EFFECTS, true))
  }
  if (type === 'ornament') fields.push(choiceField('starRank', '星辉石锻数', ranks(attrs.level ? Math.min(16, Math.floor(Number(attrs.level) / 10)) : 16), false, false), choiceField('bellSet', '钟灵石套装', BELL_SETS), choiceField('bellLevel', '钟灵石等级', choices(Array.from({ length: 8 }, (_, i) => String(i + 1))).map(o => ({ ...o, label: o.value + '级' })), false, false))
  if (type === 'jade') {
    const spells = AMBUSH_SKILLS.filter(o => {
      if (o.group.startsWith('法术·')) return !roleSchool.value || o.group === '法术·' + roleSchool.value
      return !attrs.jadeKind || (attrs.jadeKind === '阳玉' ? o.group === '特技' : o.group === '道具')
    })
    fields.push(choiceField('jadeKind', '玉魄种类', choices(['阳玉', '阴玉']), false, false), choiceField('itemId', '物品名称', itemOptions.value, false, false), choiceField('dustRank', '五色灵尘锻数', ranks(15), false, false), choiceField('jadeEffects', '玉魄技能（可多选）', JADE_EFFECTS, true), choiceField('ambushSkills', '奇袭内容（可多选）', spells, true))
