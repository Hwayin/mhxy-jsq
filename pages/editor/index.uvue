}
function numericRows(strict: boolean): NumericAttribute[] {
  const result: NumericAttribute[] = []
  for (let i = 0; i < greenRows.value.length; i++) {
    const row = greenRows.value[i]
    if (!row.kind || !/^\d{1,6}(\.\d{1,2})?$/.test(row.value.trim())) {
      if (strict) throw new Error('第' + (i + 1) + '条属性请选择类型并填写数值，最多两位小数')
      continue
    }
    const magnitude = Number(row.value)
    // UTS 的类型化对象会为省略字段补 null，条件展开会覆盖已有 kind/value。
    const attribute: NumericAttribute = { kind: row.kind, value: magnitude === 0 ? 0 : magnitude * (row.negative ? -1 : 1) }
    if (row.unit) attribute.unit = row.unit
