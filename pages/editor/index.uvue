.numeric-input-row { flex-direction: row; align-items: center; margin-top: 14rpx; }
.numeric-sign { font-size: 32rpx; color: #287565; background-color: #e7f0ea; padding: 16rpx; border-radius: 12rpx; margin-right: 12rpx; }
.numeric-value { flex: 1; margin-right: 12rpx; }
.numeric-unit { font-size: 24rpx; color: #287565; padding: 12rpx; }
.base-section { margin-top: 24rpx; }
.calculation-panel { background-color: #edf3ed; padding: 20rpx; border-radius: 16rpx; margin-top: 24rpx; }
.metric-row { margin-top: 16rpx; }
.metric-label { font-size: 24rpx; color: #6d7e74; }
.metric-value { font-size: 30rpx; color: #287565; font-weight: bold; }
.metric-formula { font-size: 22rpx; color: #6d7e74; line-height: 34rpx; }
.quantity-label { margin-top: 20rpx; }
.stepper { flex-direction: row; margin-top: 28rpx; margin-bottom: 12rpx; }
.step-item { flex: 1; align-items: center; padding: 12rpx 0; }
.step-number { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 24rpx; background-color: #e4e8de; color: #6d7e74; font-size: 24rpx; }
.step-label { font-size: 24rpx; color: #6d7e74; margin-top: 12rpx; }
.step-active { background-color: #e7f0ea; border-radius: 18rpx; }
.selected-item { margin-bottom: 22rpx; }
.selected-item-copy { margin-left: 22rpx; }
.equipment-section { background-color: #fffefb; padding: 0; }
.editor-dock { flex-direction: row; align-items: center; }
.previous-step { padding-right: 28rpx; }
.editor-submit { flex: 1; }
.review-panel { margin-top: 24rpx; }
.review-name { margin-top: 20rpx; margin-bottom: 24rpx; }
.review-money { color: #287565; font-size: 40rpx; font-weight: bold; }
.review-note { margin-top: 16rpx; }
.step-hint { margin-top: 24rpx; }
.editor-error { padding: 20rpx; background-color: #fff4df; border-radius: 16rpx; }
.amount-group { padding-top: 16rpx; border-top-width: 1rpx; border-top-color: #e8ebe2; }
.category-context { font-size: 22rpx; padding: 8rpx 0; }
.identity-fields { flex-direction: row; flex-wrap: wrap; }
.identity-field { width: 48%; margin-right: 2%; }
.identity-wide { width: 100%; margin-right: 0; }
.stepper { margin-top: 0; }
.review-configuration { margin-top: 26rpx; padding-top: 24rpx; border-top-width: 1rpx; border-top-color: #e8ebe2; }
</style>
