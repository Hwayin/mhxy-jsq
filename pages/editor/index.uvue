function toggleExtraGem() { extraGemEnabled.value = !extraGemEnabled.value; if (!extraGemEnabled.value) { attrs.extraGem = ''; attrs.extraGemRank = '' } }
const calculationPreview = computed(() => {
  const role = parentRole.value
  if (!role) return {metrics:[],notes:[]}
  const record: Asset = { id:'preview',roleId:role.id,name:'',category:'equipment',subtype:form.subtype,costCents:0,included:false,date:'',detail:'',note:'',attributes:{ slot:attrs.slot,level:attrs.level ? Number(attrs.level) : undefined,baseAttributes:baseRows(false),greenAttributes:numericRows(false),valuesStage:attrs.valuesStage,gem:attrs.gem,gemRank:attrs.gemRank !== '' ? Number(attrs.gemRank) : undefined,extraGem:attrs.extraGem,extraGemRank:attrs.extraGemRank !== '' ? Number(attrs.extraGemRank) : undefined,starRank:attrs.starRank !== '' ? Number(attrs.starRank) : undefined,dustRank:attrs.dustRank !== '' ? Number(attrs.dustRank) : undefined,jadeKind:attrs.jadeKind } }
  return equipmentCalculation(record,role)
})
const reviewConfiguration = computed(() => {
  try { return attributeText({ id: 'preview', roleId: parent.value, name: generatedName.value, category: 'equipment', subtype: form.subtype, costCents: 0, included: form.included, date: form.date, detail: form.detail, note: form.note, attributes: buildAttributes() }) }
  catch(e) { return '属性待完善' }
})
function buildRules(): CalculationRules {
