const generatedName = computed(() => equipmentName({ id: recordId.value, roleId: parent.value, name: '', costCents: 0, included: false, date: '', detail: '', note: '', category: 'equipment', subtype: form.subtype, attributes: { ...attrs, level: attrs.level !== '' ? Number(attrs.level) : undefined, gemRank: attrs.gemRank !== '' ? Number(attrs.gemRank) : undefined, extraGemRank: attrs.extraGemRank !== '' ? Number(attrs.extraGemRank) : undefined, starRank: attrs.starRank !== '' ? Number(attrs.starRank) : undefined, dustRank: attrs.dustRank !== '' ? Number(attrs.dustRank) : undefined, bellLevel: attrs.bellLevel !== '' ? Number(attrs.bellLevel) : undefined, greenAttributes: numericRows(false), baseAttributes: baseRows(false) } }))
const raceName = computed(() => RACES.find(r => r.key === form.race)?.label || '请选择种族')
const fixedPreset = computed(() => FIXED_PRESETS.find(p => p.school === form.school))
const roleRateFields = computed(() => [
  { key:'magicDamageRate', label:'伤害→法伤系数', hint:'默认 0.25，命中不参与' },
  { key:'powerRate', label:'力量→伤害系数', hint:'默认 ' + (RACES.find(r => r.key === form.race)?.power || '需选择种族') },
  { key:'enduranceRate', label:'耐力→防御系数', hint:'默认 ' + (RACES.find(r => r.key === form.race)?.endurance || '需选择种族') },
  ...(rules.fixedEnabled ? [{ key:'fixedDamageRate',label:'伤害→固伤系数',hint:'默认 ' + (fixedPreset.value?.damage ?? '需自定义') },{key:'fixedAgilityRate',label:'敏捷→固伤系数',hint:'默认 ' + (fixedPreset.value?.agility ?? '需自定义') }] : [])
])
const baseKinds = computed(() => form.subtype === 'gear' ? BASE_FIELDS[attrs.slot] || [] : attrs.baseKind ? [attrs.baseKind] : [])
function baseRows(strict: boolean): NumericAttribute[] {
  const rows: NumericAttribute[] = []
