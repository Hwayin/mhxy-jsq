<template>
  <view :class="['item-frame', large ? 'item-frame-large' : '', small ? 'item-frame-small' : '']">
    <image v-if="source && !failed" :class="['item-image', large ? 'item-image-large' : '', small ? 'item-image-small' : '']" :src="source" mode="aspectFit" @error="failed = true" />
    <text v-else class="item-fallback">{{ (label || '物').slice(0, 1) }}</text>
  </view>
</template>
<script setup>
import { itemIconSource } from '../lib/item-icons.uts'
const props = defineProps<{ itemId: string; itemName: string; label: string; large?: boolean; small?: boolean }>()
const failed = ref(false)
const source = computed(() => itemIconSource(props.itemId, props.itemName))
watch(source, () => { failed.value = false })
</script>
<style>
.item-frame { width: 100rpx; height: 100rpx; flex-shrink: 0; background-color: #f0f2e9; border-radius: 20rpx; align-items: center; justify-content: center; }
.item-image { width: 88rpx; height: 88rpx; }
.item-frame-large { width: 144rpx; height: 144rpx; border-radius: 24rpx; }
.item-image-large { width: 128rpx; height: 128rpx; }
.item-frame-small { width: 76rpx; height: 76rpx; border-radius: 14rpx; margin-right: 20rpx; }
.item-image-small { width: 68rpx; height: 68rpx; }
.item-fallback { font-size: 36rpx; color: #728d7b; font-weight: bold; }
</style>
